# SQL Server password used by docker-compose.yml
SA_PASSWORD=<CHANGE_ME_STRONG_SQL_PASSWORD>

# Frontend API endpoint (used by Vite)
VITE_API_URL=http://localhost:5153/api

# ASP.NET Core configuration override for JWT key
# 32+ random characters recommended
GestionEspaces__Jwt__SigningKey=<CHANGE_ME_32_PLUS_CHAR_RANDOM_KEY>
